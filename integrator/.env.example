APP_ENV=local
APP_DEBUG=1
# Diisi otomatis oleh `php bin/console key:generate` atau saat pertama dijalankan.
APP_KEY=

# Nilai di bawah ini opsional: kredensial utama disimpan di database lokal
# (halaman Pengaturan) dan dienkripsi dengan APP_KEY.
SIAKAD_BASE_URL=
SIAKAD_API_KEY=
FEEDER_BASE_URL=
FEEDER_USERNAME=
FEEDER_PASSWORD=
